{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-state-engine/schemas/internal/call_record.v1.json",
  "title": "CallRecord",
  "description": "Internal DTO v1. Per-attempt replay/cost/metrics unit written by the LLMGateway to the Event Log. From docs/contracts/internal-dtos.md §8, database.md §4.5, llm-provider-architecture.md §5.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "llm_job",
    "attempt_index",
    "provider",
    "model_id",
    "prompt_version",
    "prompt_hash",
    "rendered_prompt",
    "response",
    "response_hash",
    "latency_ms",
    "input_tokens",
    "output_tokens",
    "estimated_cost",
    "retries",
    "finish_reason",
    "outcome",
    "created_at"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "llm_job": {
      "type": "string",
      "enum": ["sentiment", "synthesis"]
    },
    "attempt_index": { "type": "integer", "minimum": 0 },
    "provider": { "type": "string" },
    "model_id": { "type": "string" },
    "prompt_version": { "type": "string" },
    "prompt_hash": { "type": "string" },
    "rendered_prompt": { "type": "string" },
    "response": { "type": ["object", "null"] },
    "response_hash": { "type": ["string", "null"] },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "estimated_cost": { "type": ["number", "null"], "minimum": 0 },
    "retries": { "type": "integer", "minimum": 0 },
    "finish_reason": { "type": ["string", "null"] },
    "outcome": {
      "type": "string",
      "enum": ["success", "timeout", "error", "circuit_open"]
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
