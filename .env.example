# Market State Engine — environment variables (12-factor; secrets via ENV only).
# Copy to `.env` for local use. The real `.env` is git-ignored and never committed.
#
# Milestone 3 (deterministic core) requires NO secrets — mock ingestors, no LLM, no DB.
# The variables below are documented now for later milestones (M4 LLM, M5 persistence).

# --- Runtime environment (M5) ---
# One of: dev | staging | prod
MSE_ENV=dev

# --- Database (M5; dev uses SQLite, no DSN needed) ---
# DB_DSN=postgresql://user:pass@localhost:5432/market_state   # staging/prod only

# --- External LLM Providers (M4; names referenced by config/models/providers.yaml api_key_env) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Market-data source (M5; USD/IRR via kifpool) ---
KIFPOOL_API_KEY=https://api.kifpool.app/api/spot/price       # read-only market-data scope
